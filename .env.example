# Cadena de conexión de MongoDB (Atlas: restringe el acceso por IP y usa un usuario con permisos mínimos)
DATABASE_URL=mongodb+srv://USUARIO:PASSWORD@cluster.mongodb.net/uptask
# URL exacta del frontend, sin "/" al final (se usa para CORS y en los correos)
FRONTEND_URL=https://tu-frontend.com
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Genera uno con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
# En producción
NODE_ENV=production
# Si despliegas detrás de un proxy/balanceador (Render, Railway, Nginx...)
TRUST_PROXY=1
